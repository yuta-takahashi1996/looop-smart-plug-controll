# Application
APP_ENV=development
TZ=Asia/Tokyo
DRY_RUN=true

# Web UI
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Operation
OPERATION_START=09:00
OPERATION_END=18:00

# Looop
LOOOP_AREA=hokkaido
FORECAST_RETRY_COUNT=3

# SwitchBot
SWITCHBOT_TOKEN=
SWITCHBOT_SECRET=
SWITCHBOT_DEVICE_ID=

# Optimization
MIN_SAVING_SPREAD=20
ROUND_TRIP_EFFICIENCY=0.85

MAX_CONTINUOUS_OFF_MINUTES=120
MAX_DAILY_OFF_MINUTES=180
MIN_SWITCH_INTERVAL_MINUTES=30

ESTIMATED_AVERAGE_POWER_W=150

# Logging
LOG_LEVEL=INFO
